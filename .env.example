# Database Configuration (MySQL)
# When deploying to Railway, Railway will inject MYSQL_URL automatically if you link the MySQL service.
MYSQL_URL=mysql://root:password@localhost:3306/ecotown

# Alternatively, configure via individual host parameters:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=ecotown

# Server Port
PORT=3001

# Auth Security
JWT_SECRET=nordic-datacenter-secret-key-2026

# Frontend (Vite) API URL (When deploying frontend to Vercel, point to your Railway domain)
# VITE_API_URL=https://your-railway-app.up.railway.app
